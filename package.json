{
  "name": "news-cast-ai",
  "version": "2.0.0",
  "description": "Автопостинг ИИ-новостей в Telegram-канал: парсинг RSS/HTML → скилл Claude Code (content-adaptor v2) → картинки через ProxyAPI → публикация через Telegram Bot API.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/index.js",
    "post:once": "node src/index.js",
    "post:once:dry": "node src/index.js --dry-run",
    "schedule": "node src/index.js --schedule",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix"
  },
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "dotenv": "^16.6.1",
    "jimp": "^1.6.1",
    "node-cron": "^3.0.3",
    "playwright": "^1.62.1",
    "rss-parser": "^3.13.0",
    "ssh2-sftp-client": "^12.1.1"
  },
  "devDependencies": {
    "eslint": "^9.39.5"
  }
}
