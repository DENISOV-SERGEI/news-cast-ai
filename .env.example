# Ollama Cloud API (двухэтапная адаптация)
OLLAMA_API_BASE=https://ollama.com
OLLAMA_API_KEY=your_ollama_key

# Модели для двухэтапной адаптации
MODEL_SUMMARY=deepseek-v4-flash:0731
MODEL_SOCIAL=deepseek-v4-pro:0813

# Telegram Bot API
TELEGRAM_BOT_TOKEN=your_bot_token
# Личный чат: положительный ID (например, 962790782).
# Канал/группа: ID вида -100xxxxxxxxxx.
TELEGRAM_CHAT_ID=962790782
TELEGRAM_API_BASE=https://api.telegram.org
# Опционально: чат для алертов об ошибках (если не задан — алерты не шлются)
TELEGRAM_ERROR_CHAT_ID=
# Минимальный интервал между запросами к Telegram Bot API (мс). Защита от бана при всплеске.
TELEGRAM_RATE_LIMIT_MS=1000

# --- Dzen Sync через @zen_sync_bot (опционально) ---
# Отдельный ПУБЛИЧНЫЙ Telegram-канал для синхронизации с Яндекс Дзен.
# Из этого канала официальный бот @zen_sync_bot забирает посты в Дзен.
# Контент — расширенная версия (social.yandex_dzen, 1500-2500 символов, с тегами),
# отдельная от короткой social.telegram.
#
# Требования:
#   1) Создайте публичный Telegram-канал (@my_dzen_channel).
#   2) Добавьте вашего бота (тот же TELEGRAM_BOT_TOKEN) админом канала.
#   3) Добавьте @zen_sync_bot в канал и выдайте ему права на публикацию.
#   4) Следуйте инструкциям @zen_sync_bot для привязки канала к Дзен-аккаунту.
#
# Если пусто — синхронизация с Дзен через Telegram отключена (drafts/dzen-N.md
# остаётся для ручной публикации в редакторе Дзен).
# Пример: TELEGRAM_DZEN_SYNC_CHAT_ID=@my_dzen_channel или -100xxxxxxxxxx
TELEGRAM_DZEN_SYNC_CHAT_ID=

# ProxyAPI (генерация изображений через gpt-image-1-mini)
PROXY_API_KEY=sk-...
PROXY_API_BASE=https://api.proxyapi.ru/openai/v1
PROXY_IMAGE_MODEL=gpt-image-1-mini

# VK API (опционально; если пусто — публикация в VK пропускается)
VK_ACCESS_TOKEN=vk1.a.xxxxx
VK_GROUP_ID=123456789
VK_API_VERSION=5.199
# Минимальный интервал между запросами к VK API (мс). Защита от error_code=6.
VK_RATE_LIMIT_MS=350
# User-token от имени админа группы. Зарезервирован на будущее; в текущем
# пайплайне НЕ используется (паблишер работает через OG + docs.save на
# групповом токене, scope `photos` в 2026 не выдаётся Standalone-приложениям).
VK_USER_ACCESS_TOKEN=
# CSV доменов, для которых VK гарантированно не подтянет og:image —
# для них паблишер сразу идёт через docs.save (наш PNG как документ).
# Формат: CSV, lower-case, без www. Пусто = все домены идут по OG-пути
# (плюс авто-fallback, если в посте нет ссылки на оригинал).
# Пример: VK_OG_FALLBACK_DOMAINS=techcrunch.com,deepmind.google
VK_OG_FALLBACK_DOMAINS=

# WordPress-сайт (опционально; если пусто — публикация на сайт пропускается)
# SITE_API_URL — база WP REST API, например https://example.com/wp-json/wp/v2
# SITE_API_KEY — application password (X-Application-Auth или Basic Auth)
SITE_API_URL=
SITE_API_KEY=

# Пути (можно не менять)
SESSIONS_DIR=./sessions
POSTS_DIR=./posts
IMAGES_DIR=./images
DRAFTS_DIR=./drafts
# Каталог для ручной модерации (режим --review / --publish-pending)
PENDING_DIR=./pending
# Кэш cookie для авто-обхода SiteGround-капчи (живёт ~месяц).
# SG-challenge решается headless Chromium (Playwright) один раз, дальше
# обычные fetch-запросы идут с кэшированным cookie без браузера.
# SG_COOKIES_PATH=./database/sg_cookies.json
# Полное отключение авто-обхода капчи (если Playwright/Chromium недоступен):
# DISABLE_SG_CAPTCHA_RESOLVER=0
# Экспорт «Новости» для статического сайта business_card: агрегат заголовков
# последних постов в news.json (читается сайтом). Путь — абсолютный или
# относительный от корня проекта. Значение off — отключить экспорт.
BUSINESS_CARD_NEWS_PATH=../business_card/news.json
# Страница статей на сайте business_card (полные тексты, топ-10 за 14 дней).
# SITE_ARTICLES_DIR — каталог с отдельными HTML-страницами статей;
# SITE_ARTICLES_LIST_PATH — список статей (articles.html).
# Значение off для SITE_ARTICLES_DIR — отключить экспорт.
SITE_ARTICLES_DIR=../business_card/articles
SITE_ARTICLES_LIST_PATH=../business_card/articles.html
# Автодеплой сгенерированных файлов (news.json, articles.html, articles/*)
# на хостинг по SFTP/SSH. Включается только если заданы ВСЕ три переменные.
# Хост/логин/пароль берутся в панели хостинга (Beget: Домены → FTP-доступ,
# там же можно создать отдельного FTP-пользователя с доступом только к сайту).
# SSH-доступ должен быть включён в панели (Домены → SSH-доступ).
# При подключении мы попадаем в корень сайта — DEPLOY_FTP_REMOTE_DIR не нужен.
# DEPLOY_SFTP_PORT=22 — порт SSH.
# DEPLOY_SITE_URL — публичный URL сайта для HTTP-проверки после деплоя
# (пайплайн делает fetch к <url>/news.json и сверяет, что сайт отдаёт свежие данные).
# DEPLOY_FTP_HOST=ftp.example.com
# DEPLOY_FTP_PORT=21
# DEPLOY_SFTP_PORT=22
# DEPLOY_FTP_USER=user
# DEPLOY_FTP_PASS=password
# DEPLOY_FTP_SECURE=0
# DEPLOY_FTP_REMOTE_DIR=/public_html
# DEPLOY_SITE_URL=https://example.com
# Сколько дней хранить старые файлы в images/, sessions/, posts/ (0 — не чистить).
# RETENTION_DAYS=30
# Кэш картинок image_prompt → файл (переиспользование, экономия ProxyAPI)
IMAGE_CACHE_PATH=./database/image_cache.json
# История прогонов для наблюдаемости (ежедневный отчёт в TELEGRAM_ERROR_CHAT_ID)
RUNS_PATH=./database/runs.json

# SOURCES (CSV) — все источники, по 1 свежей статье на источник за прогон.
SOURCES=https://www.artificialintelligence-news.com/feed,https://techcrunch.com/category/artificial-intelligence/feed/,https://deepmind.google/blog/rss.xml

# CSV доменов, которые нужно пропустить (например, "medium.com,reddit.com").
# Сравнение по hostname (lowercase, без www.); parent-домены тоже ловятся:
# если в списке "medium.com" — отбрасываются и "blog.medium.com".
SOURCE_BLOCKLIST=
# CSV подстрок (lowercase): статьи с такими словами в заголовке отбрасываются
# (например, "weekly roundup,newsletter,top 10"). Сравнение — substring.
TITLE_STOPWORDS=

# Настройки пайплайна
ARTICLES_PER_RUN=3
# Свежесть статей: 1 = только сегодня, 7 = за неделю, 0 = без фильтра.
FRESH_WINDOW_DAYS=1

# === Пилотный конфиг (минимум: 4 источника, 2×2/день, без картинок) ===
# Этот блок — для первого запуска. Скопируйте нужные строки в свой .env,
# закомментируйте/уберите строки выше, если идёте в пилот.
#
# SOURCES=https://techcrunch.com/category/artificial-intelligence/feed/,https://www.artificialintelligence-news.com/feed,https://www.marktechpost.com/feed/,https://deepmind.google/blog/rss.xml
# SCHEDULE_CRON=0 9 * * *,0 17 * * *
# ARTICLES_PER_RUN=2
# FRESH_WINDOW_DAYS=3
# DISABLE_IMAGE_GENERATION=1
# SOURCE_LINK_LABEL=🔗 Оригинал статьи
# Временный запрет на генерацию картинок (1/true/yes/да — выключено). Посты публикуются без фото.
DISABLE_IMAGE_GENERATION=0
POST_INTERVAL_MS=60000
# Расписание: CSV cron-выражений. Каждое выражение — отдельный запуск.
# Примеры:
#   0 */2 * * *              — каждые 2 часа
#   0 8 * * *,0 15 * * *     — в 8:00 и 15:00 каждый день
SCHEDULE_CRON=0 8 * * *,0 15 * * *
LOG_LEVEL=info
# Путь к файлу логов (если пусто — логи только в console). Пример: ./logs/news-cast-ai.log
# При --schedule на сервере ОБЯЗАТЕЛЬНО задать — иначе логи между рестартами теряются.
LOG_FILE=
# Сколько дней хранить архивные файлы логов (logs/news-cast-ai.YYYY-MM-DD.log).
LOG_RETENTION_DAYS=7

# Алерт о «молчании»: node src/index.js --health шлёт алерт в
# TELEGRAM_ERROR_CHAT_ID, если последний прогон старше N часов (0 — выкл).
# Вешается на внешний cron (планировщик ОС), т.к. умерший --schedule сам не сообщит.
SILENCE_ALERT_HOURS=6
# RSS-фид секции новостей: генерируется рядом с news.json (rss.xml).
# SITE_RSS_PATH задаёт явный путь; SITE_RSS_PATH=off — фид не генерируется.
SITE_RSS_PATH=
